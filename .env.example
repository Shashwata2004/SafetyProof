# Server settings. Copy to .env or inject into the FastAPI deployment environment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set from this Gemini project's permitted rate.
MIN_REQUEST_INTERVAL=1

# Enable only on Vercel deployments; local development uses the leased worker loop.
QUEUE_ENABLED=false
